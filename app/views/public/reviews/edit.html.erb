<div class="container">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
      <div class="card shadow">
        <div class="card-body p-4">
          <h2 class="card-title text-center mb-4">レビュー編集</h2>
          <%= render 'layouts/errors', obj: @review %>
          <%= form_with model: @review, url: restaurant_review_path(@review.restaurant_id, @review), method: :patch, local: true do |f| %>
          <div id="star" class="mb-3"></div>
            <script>
              var elem = document.querySelector('#star');
              var opt = {
                starOn: "<%= asset_path('raty/star-on.png') %>",
                starOff: "<%= asset_path('raty/star-off.png') %>",
                starHalf: "<%= asset_path('raty/star-half.png') %>",
                scoreName: "review[rating]"
              };
              raty(elem,opt);
            </script>
            <div class="field">
              <%= f.text_area :body, placeholder: "ここにレビューを記載してください", class: "form-control mb-3" %>
            </div>
            <div class="actions">
              <%= f.submit "更新", class: "btn btn-primary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>